#!/bin/sh
# Installed by `make hooks` (run by `make up`). The checks run in the containers: start the stack with `make up`.
# They print a lot: only a failure shows its output.

# A commit takes the index, not the working tree: refuse a staged file that changed again since `git add`.
tmp=$(mktemp -d)
log=$tmp/log
trap 'rm -rf "$tmp"' EXIT
git diff --cached --name-only | sort > "$tmp/staged"
git diff --name-only | sort > "$tmp/unstaged"
stale=$(comm -12 "$tmp/staged" "$tmp/unstaged")
if [ -n "$stale" ]; then
    echo "Staged files with unstaged changes (the commit would not contain them):"
    echo "$stale" | sed 's/^/  /'
    echo "Run \`git add\` on them again."
    exit 1
fi

# Code comes with its tests: warn when PHP code under src/ is staged and nothing under tests/ is.
# A warning only: a move or an interface alone is a fair commit without a test.
if git diff --cached --name-only --diff-filter=AM | grep -qE '^src/.*\.php$' \
    && ! git diff --cached --name-only --diff-filter=AM | grep -q '^tests/'; then
    echo "Warning: PHP code under src/ is staged without any test under tests/."
fi

if make precommit > "$log" 2>&1; then
    echo "make precommit: ok"
else
    cat "$log"
    exit 1
fi
